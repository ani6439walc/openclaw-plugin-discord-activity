{
  "name": "discord-tool-status",
  "displayName": "Discord Tool Status",
  "description": "Shows live tool-call status as a Discord message that is updated and deleted when the agent finishes.",
  "version": "2026.6.5",
  "type": "module",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-discord-tool-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-discord-tool-status.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-discord-tool-status/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "discord",
    "tool-status"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.6.5",
      "minGatewayVersion": "2026.6.5"
    },
    "build": {
      "openclawVersion": "2026.6.5",
      "pluginSdkVersion": "2026.6.5"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run typecheck && pnpm run test:unit",
    "test:unit": "vitest run",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": "2026.6.5",
    "typebox": "1.1.39"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
