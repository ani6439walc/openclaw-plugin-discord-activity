{
  "name": "discord-activity",
  "displayName": "Discord Activity",
  "description": "Shows live agent and tool activity as a Discord message that is updated and deleted when the agent finishes.",
  "version": "2026.7.1-2",
  "type": "module",
  "license": "MIT",
  "author": "Ani <ani6439walc@gmail.com>",
  "contributors": [
    "Wan, Jiun Wei <wei840222@gmail.com>"
  ],
  "homepage": "https://github.com/ani6439walc/openclaw-plugin-discord-activity#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ani6439walc/openclaw-plugin-discord-activity.git"
  },
  "bugs": {
    "url": "https://github.com/ani6439walc/openclaw-plugin-discord-activity/issues"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "discord",
    "activity",
    "progress"
  ],
  "files": [
    "README.md",
    "package.json",
    "openclaw.plugin.json",
    "dist"
  ],
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md' '**/*.json' '**/*.ts'",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "openclaw": "2026.7.1-2"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "prettier": "3.9.6"
  }
}
